import json
import os

FILE_NAME = "students.json"


def load_students():
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r") as file:
            return json.load(file)
    return []


def save_students(students):
    with open(FILE_NAME, "w") as file:
        json.dump(students, file, indent=4)


students = load_students()


def add_student():
    roll = input("Enter Student ID/Roll Number: ")

    for student in students:
        if student["roll"] == roll:
            print("Student with this ID already exists!")
            return

    name = input("Enter Student Name: ")
    class_section = input("Enter Class/Section: ")
    marks = input("Enter Marks/Grade: ")
    phone = input("Enter Phone Number: ")

    student = {
        "roll": roll,
        "name": name,
        "class_section": class_section,
        "marks": marks,
        "phone": phone
    }

    students.append(student)
    save_students(students)

    print("Student added successfully!")


def view_students():
    if not students:
        print("No students found!")
        return

    print("\n---------- STUDENT LIST ----------")

    for student in students:
        print("ID/Roll Number :", student["roll"])
        print("Name           :", student["name"])
        print("Class/Section  :", student["class_section"])
        print("Marks/Grade    :", student["marks"])
        print("Phone          :", student["phone"])
        print("----------------------------------")


def search_student():
    roll = input("Enter Student ID/Roll Number to search: ")

    for student in students:
        if student["roll"] == roll:
            print("\nStudent Found!")
            print("ID/Roll Number :", student["roll"])
            print("Name           :", student["name"])
            print("Class/Section  :", student["class_section"])
            print("Marks/Grade    :", student["marks"])
            print("Phone          :", student["phone"])
            return

    print("Student not found!")


def update_student():
    roll = input("Enter Student ID/Roll Number to update: ")

    for student in students:
        if student["roll"] == roll:

            print("\nLeave field empty to keep old value.")

            name = input(f"Enter Name [{student['name']}]: ")
            class_section = input(
                f"Enter Class/Section [{student['class_section']}]: "
            )
            marks = input(f"Enter Marks/Grade [{student['marks']}]: ")
            phone = input(f"Enter Phone [{student['phone']}]: ")

            if name:
                student["name"] = name

            if class_section:
                student["class_section"] = class_section

            if marks:
                student["marks"] = marks

            if phone:
                student["phone"] = phone

            save_students(students)

            print("Student updated successfully!")
            return

    print("Student not found!")


def delete_student():
    roll = input("Enter Student ID/Roll Number to delete: ")

    for student in students:
        if student["roll"] == roll:
            students.remove(student)
            save_students(students)

            print("Student deleted successfully!")
            return

    print("Student not found!")


def main():
    while True:
        print("\n========== SCHOOL MANAGEMENT SYSTEM ==========")
        print("1. Add Student")
        print("2. View Students")
        print("3. Search Student")
        print("4. Update Student")
        print("5. Delete Student")
        print("6. Exit")
        print("==============================================")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_student()

        elif choice == "2":
            view_students()

        elif choice == "3":
            search_student()

        elif choice == "4":
            update_student()

        elif choice == "5":
            delete_student()

        elif choice == "6":
            print("Thank you for using School Management System!")
            break

        else:
            print("Invalid choice! Please try again.")


main()
